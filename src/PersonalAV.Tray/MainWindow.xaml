<Window x:Class="PersonalAV.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersonalAV" Width="640" Height="620" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status band: its colour and text follow the service and last-scan state. -->
        <Border x:Name="StatusBand" DockPanel.Dock="Top" Background="Gray" Padding="20,18">
            <StackPanel>
                <TextBlock x:Name="StatusTitle" Text="Connecting..." FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" Foreground="White" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Shown when a newer PersonalAV version is published. -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#E3F2FD" BorderBrush="#90CAF9"
                BorderThickness="0,0,0,1" Padding="20,12" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallUpdateButton" Content="Install update" Click="InstallUpdate_Click" />
                    <Button x:Name="WhatsNewButton" Content="What's new" Click="WhatsNew_Click" Margin="0" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateDetail" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#37474F" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#F5F5F5">
            <DockPanel>
                <TextBlock x:Name="FooterText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray"
                           Text="On-demand scanning. Microsoft Defender stays your real-time protection." TextWrapping="Wrap"
                           MaxWidth="260" TextAlignment="Right" FontSize="11" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Scan results" Click="Results_Click" />
                    <Button Content="Quarantine" Click="Quarantine_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel>
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Scan" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QuickButton" Content="Quick scan" Click="Quick_Click" />
                        <Button x:Name="FullButton" Content="Full scan" Click="Full_Click" />
                        <Button x:Name="FolderButton" Content="Scan folder..." Click="Folder_Click" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" />
                    <TextBlock x:Name="CountsText" Margin="0,8,0,0" />
                    <TextBlock x:Name="CurrentText" Margin="0,4,0,0" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Detection engine" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hash blocklist" Foreground="Gray" Margin="0,0,16,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HashText" Text="-" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="YARA rules" Foreground="Gray" Margin="0,0,16,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RulesText" Text="-" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Updates" Foreground="Gray" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UpdatesText" Text="-" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="UpdateButton" Content="Check for updates" Click="Update_Click" />
                        <Button x:Name="ImportButton" Content="Import hashes..." Click="Import_Click" />
                        <Button x:Name="ReloadButton" Content="Reload rules" Click="Reload_Click" />
                    </StackPanel>
                    <TextBlock x:Name="EngineStatus" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
