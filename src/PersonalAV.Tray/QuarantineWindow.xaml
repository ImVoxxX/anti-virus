<Window x:Class="PersonalAV.Tray.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersonalAV - Quarantine" Width="860" Height="460" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12">
            Quarantined files are encrypted and cannot run. Restore puts a file back exactly where it was;
            Delete removes it permanently.
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="RestoreButton" Content="Restore" Click="Restore_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" IsEnabled="False" />
            <Button Content="Refresh" Click="Refresh_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <DataGrid x:Name="Entries" SelectionChanged="Entries_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quarantined" Binding="{Binding QuarantinedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                <DataGridTextColumn Header="Threat" Binding="{Binding ThreatName}" Width="200" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat=N0}" Width="90" />
                <DataGridTextColumn Header="Original path" Binding="{Binding OriginalPath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
